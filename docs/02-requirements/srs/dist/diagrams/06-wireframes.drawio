" height="46" as="geometry"/></mxCell><mxCell id="c14" value="Bắt buộc" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#667B78;" parent="1" vertex="1"><mxGeometry x="280" y="444" width="1020" height="20" as="geometry"/></mxCell><mxCell id="c15" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#555555;" parent="1" vertex="1"><mxGeometry x="280" y="470" width="20" height="20" as="geometry"/></mxCell><mxCell id="c16" value="Tôi đã đọc và đồng ý điều khoản xử lý dữ liệu cá nhân" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontColor=#1B2A29;" parent="1" vertex="1"><mxGeometry x="308" y="468" width="992" height="24" as="geometry"/></mxCell><mxCell id="c17" value="Tùy chọn" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#667B78;" parent="1" vertex="1"><mxGeometry x="280" y="518" width="1020" height="20" as="geometry"/></mxCell><mxCell id="c18" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#555555;" parent="1" vertex="1"><mxGeometry x="280" y="544" width="20" height="20" as="geometry"/></mxCell><mxCell id="c19" value="Cho phép xử lý dữ liệu sức khỏe của tôi bằng AI (tóm tắt, trích xuất, dự đoán). Mặc định không chọn." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontColor=#1B2A29;" parent="1" vertex="1"><mxGeometry x="308" y="542" width="992" height="24" as="geometry"/></mxCell><mxCell id="c20" value="Đăng ký" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#0F6E66;strokeColor=#0F6E66;fontSize=12;fontColor=#1B2A29;fontStyle=1;fontColor=#FFFFFF;" parent="1" vertex="1"><mxGeometry x="280" y="596" width="99" height="38" as="geometry"/></mxCell><mxCell id="c21" value="Hủy" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#C9D6D4;fontSize=12;fontColor=#1B2A29;fontStyle=1;fontColor=#1B2A29;" parent="1" vertex="1"><mxGeometry 