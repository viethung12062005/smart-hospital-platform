hiteSpace=wrap;html=1;arcSize=12;align=left;spacingLeft=14;fontSize=12;fillColor=#DDEBE8;strokeColor=none;fontColor=#0F6E66;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="32" y="118" width="226" height="34" as="geometry"/></mxCell><mxCell id="c5009" value="Wireframe: bản phác thảo, chưa có trong giao diện web hiện tại" style="text;html=1;align=right;fontSize=10;fontColor=#667B78;" parent="1" vertex="1"><mxGeometry x="870" y="664" width="440" height="20" as="geometry"/></mxCell><mxCell id="c1" value="Tôi đã từng khám tại bệnh viện" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=20;fontColor=#1B2A29;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="280" y="92" width="1020" height="36" as="geometry"/></mxCell><mxCell id="c2" value="Nhập đúng thông tin đã đăng ký tại bệnh viện. Mã xác minh chỉ được gửi tới số điện thoại lưu trong hồ sơ." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontColor=#667B78;" parent="1" vertex="1"><mxGeometry x="280" y="130" width="1020" height="26" as="geometry"/></mxCell><mxCell id="c3" value="Họ và tên *" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#667B78;" parent="1" vertex="1"><mxGeometry x="280" y="160" width="498" height="20" as="geometry"/></mxCell><mxCell id="c4" value="Nguyễn Thị Lan" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#C9D6D4;fontSize=12;fontColor=#1B2A29;align=left;spacingLeft=10;" parent="1" vertex="1"><mxGeometry x="280" y="182" width="498" height="34" as="geometry"/></mxCell><mxCell id="c5" value="Ngày sinh *" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#667B78;" parent="1" vertex="1"><mxGeometry x="802" y="160" width="498" height="20" as="geometry"/></mxCell><mxCell id="c6" value="12/04/1988" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#C9D6D4;fontSize=12;fontColor=#1B2A29;align=left;spacingLeft=10;" parent="1" vertex="1"><mxGeometry x="802" y="182" width="498" height="34" as="geometry"/></mxCell><mxCell id="c7" value="Số điện thoại đã đăng ký tại bệnh viện *" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#667B78;" parent="1" vertex="1"><mxGeometry x="280" y="234" width="498" height="20" as="geometry"/></mxCell><mxCell id="c8" value="0900 010 001" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#C9D6D4;fontSize=12;fontColor=#1B2A29;align=left;spacingLeft=10;" parent="1" vertex="1"><mxGeometry x="280" y="256" width="498" height="34" as="geometry"/></mxCell><mxCell id="c9" value="Mã xác minh *" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#667B78;" parent="1" vertex="1"><mxGeometry x="802" y="234" width="498" height="20" as="geometry"/></mxCell><mxCell id="c10" value="6 chữ số (gửi qua Zalo, hoặc SMS nếu không có Zalo)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#C9D6D4;fontSize=12;fontColor=#1B2A29;align=left;spacingLeft=10;" parent="1" vertex="1"><mxGeometry x="802" y="256" width="498" height="34" as="geometry"/></mxCell><mxCell id="c11" value="Nếu thông tin khớp, mã đã được gửi. Chưa nhận được sau 30 giây? Bấm “Gửi bằng SMS”. Không khớp? Đến quầy tiếp đón để được hỗ trợ." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#DDEBE8;strokeColor=#0F6E66;fontSize=12;fontColor=#1B2A29;align=left;spacingLeft=12;" parent="1" vertex="1"><mxGeometry x="280" y="312" width="1020" height="46" as="geometry"/></mxCell><mxCell id="c12" value="Gửi yêu cầu" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#0F6E66;strokeColor=#0F6E66;fontSize=12;fontColor=#1B2A29;fontStyle=1;fontColor=#FFFFFF;" parent="1" vertex="1"><mxGeometry x="280" y="370" width="135" height="38" as="geometry"/></mxCell><mxCell id="c13" value="Gửi bằng SMS" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;stro