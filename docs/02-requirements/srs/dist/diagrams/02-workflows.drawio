<mxfile host="shp-srs" type="device" pages="3"><diagram id="p0" name="Quy trình khám ngoại trú"><mxGraphModel dx="1024" dy="592" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1550" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value='&lt;p style="margin:0px;margin-top:4px;text-align:center"&gt;&lt;b&gt;Bệnh nhân&lt;/b&gt;&lt;/p&gt;' style="verticalAlign=top;align=left;overflow=fill;fontSize=12;fontFamily=Helvetica;html=1;rounded=0;shadow=0;strokeColor=#000000;gradientColor=none;whiteSpace=wrap;" parent="1" vertex="1"><mxGeometry x="40" y="40" width="300" height="820" as="geometry"/></mxCell><mxCell id="c2" value='&lt;p style="margin:0px;margin-top:4px;text-align:center"&gt;&lt;b&gt;Điều dưỡng&lt;/b&gt;&lt;/p&gt;' style="verticalAlign=top;align=left;overflow=fill;fontSize=12;fontFamily=Helvetica;html=1;rounded=0;shadow=0;strokeColor=#000000;gradientColor=none;whiteSpace=wrap;" parent="1" vertex="1"><mxGeometry x="340" y="40" width="300" height="820" as="geometry"/></mxCell><mxCell id="c3" value='&lt;p style="margin:0px;margin-top:4px;text-align:center"&gt;&lt;b&gt;Bác sĩ&lt;/b&gt;&lt;/p&gt;' style="verticalAlign=top;align=left;overflow=fill;fontSize=12;fontFamily=Helvetica;html=1;rounded=0;shadow=0;strokeColor=#000000;gradientColor=none;whiteSpace=wrap;" parent="1" vertex="1"><mxGeometry x="640" y="40" width="300" height="820" as="geometry"/></mxCell><mxCell id="c4" value='&lt;p style="margin:0px;margin-top:4px;text-align:center"&gt;&lt;b&gt;Hệ thống&lt;/b&gt;&lt;/p&gt;' style="verticalAlign=top;align=left;overflow=fill;fontSize=12;fontFamily=Helvetica;html=1;rounded=0;shadow=0;strokeColor=#000000;gradientColor=none;whiteSpace=wrap;" parent="1" vertex="1"><mxGeometry x="940" y="40" width="570" height="820" as="geometry"/></mxCell><mxCell id="c5" value="(1)&lt;br&gt;Tìm khung giờ trống và đặt lịch&lt;br&gt;(hoặc điều dưỡng đặt thay)" style="html=1;dashed=0;whitespace=wrap;shape=mxgraph.dfd.start;rounded=0;shadow=0;strokeColor=#000000;gradientColor=none;whiteSpace=wrap;fontSize=12;" parent="1" vertex="1"><mxGeometry x="75" y="140" width="230" height="60" as="geometry"/></mxCell><mxCell id="c6" value="(2)&lt;br&gt;Tạo lịch hẹn “booked”,&lt;br&gt;lên lịch nhắc, dự đoán no-show" style="html=1;dashed=0;whitespace=wrap;shape=mxgraph.dfd.start;rounded=0;shadow=0;strokeColor=#000000;gradientColor=none;whiteSpace=wrap;fontSize=12;" parent="1" vertex="1"><mxGeometry x="975" y="140" width="230" height="60" as="geometry"/></mxCell><mxCell id="c7" value="(3)&lt;br&gt;Đến giờ khám?" style="rhombus;html=1;whiteSpace=wrap;strokeColor=#000000;fontSize=11;" parent="1" vertex="1"><mxGeometry x="995" y="268" width="190" height="84" as="geometry"/></mxCell><mxCell id="c8" value="(4)&lt;br&gt;Check-in, đo sinh hiệu" style="html=1;dashed=0;whitespace=wrap;shape=mxgraph.dfd.start;rounded=0;shadow=0;strokeColor=#000000;gradientColor=none;whiteSpace=wrap;fontSize=12;" parent="1" vertex="1"><mxGeometry x="375" y="420" width="230" height="60" as="geometry"/></mxCell><mxCell id="c9" value="(5)&lt;br&gt;Mở lần khám, ghi bệnh sử,&lt;br&gt;chẩn đoán" style="html=1;dashed=0;whitespace=wrap;shape=mxgraph.dfd.start;rounded=0;shadow=0;strokeColor=#000000;gradientColor=none;whiteSpace=wrap;fontSize=12;" parent="1" vertex="1"><mxGeometry x="675" y="420" width="230" height="60" as="geometry"/></mxCell><mxCell id="c10" value="(6)&lt;br&gt;Upload kết quả, giấy tờ" style="html=1;dashed=0;whitespace=wrap;shape=mxgraph.dfd.start;rounded=0;shadow=0;strokeColor=#000000;gradientColor=none;whiteSpace=wrap;fontSize=12;" parent="1" vertex="1"><mxGeometry x="375" y="560" width="230" height="60" as="geometry"/></mxCell><mxCell id="c11" value="(7)&lt;br&gt;Kết thúc lần khám,&lt;br&gt;phát hành tài liệu cần thiết" style="html=1;dashed=0;whitespace=wrap;shape=mxgraph.dfd.start;rounded=0;shadow=0;strokeColor=#000000;gradientColor=none;whiteSpace=wrap;fontSize=12;" parent="1" vertex="1"><mxGeometry x="675" y="560" width="230" height="60" as="geometry"/></mxCell><mxCell id="c12" value="(8)&lt;br&gt;Lần khám “finished”,&lt;br&gt;lịch hẹn “fulfilled”" style="html=1;dashed=0;whitespace=wrap;shape=mxgraph.dfd.start;rounded=0;shadow=0;strokeColor=#000000;gradientColor=none;whiteSpace=wrap;fontSize=12;" parent="1" vertex="1"><mxGeometry x="975" y="560" width="230" height="60" as="geometry"/></mxCell><mxCell id="c13" value="(9)&lt;br&gt;Xem tài liệu đã phát hành" style="html=1;dashed=0;whitespace=wrap;shape=mxgraph.dfd.start;rounded=0;shadow=0;strokeColor=#000000;gradientColor=none;whiteSpace=wrap;fontSize=12;" parent="1" vertex="1"><mxGeometry x="75" y="700" width="230" height="60" as="geometry"/></mxCell><mxCell id="c14" value="(10)&lt;br&gt;Đánh dấu “noshow”, giải phóng&lt;br&gt;slot, cập nhật dữ liệu ML" style="html=1;dashed=0;whitespace=wrap;shape=mxgraph.dfd.start;rounded=0;shadow=0;strokeColor=#000000;gradientColor=none;whiteSpace=wrap;fontSize=12;" parent="1" vertex="1"><mxGeometry x="1245" y="420" width="230" height="60" as="geometry"/></mxCell><mxCell id="c15" value="" style="strokeWidth=2;html=1;shape=mxgraph.flowchart.start_2;whiteSpace=wrap;rounded=0;shadow=0;gradientColor=none;fillColor=#000000;" parent="1" vertex="1"><mxGeometry x="175" y="88" width="30" height="30" as="geometry"/></mxCell><mxCell id="c16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="1" source="c15" target="c5" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="1" source="c5" target="c6" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="c6" target="c7" 