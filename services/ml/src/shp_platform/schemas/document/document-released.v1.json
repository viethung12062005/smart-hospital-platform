{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shp.example.org/schemas/document/document-released/v1.json",
  "title": "shp.document.document-released.v1",
  "description": "E9: document released to the patient. IDs/codes/timestamps/status only, no PII. Only optional fields may be added within the same version.",
  "type": "object",
  "required": [
    "documentId",
    "patientId",
    "releasedAt",
    "type"
  ],
  "properties": {
    "documentId": {
      "type": "string",
      "format": "uuid"
    },
    "patientId": {
      "type": "string",
      "format": "uuid"
    },
    "releasedAt": {
      "type": "string",
      "format": "date-time"
    },
    "type": {
      "type": "string",
      "minLength": 1
    }
  }
}
