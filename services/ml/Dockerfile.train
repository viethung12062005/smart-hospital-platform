# syntax=docker/dockerfile:1
# Training image (MLO-02, 16-mlops §2): the environment in which a model is trained, so that "same image + same dataset
# hash + same seed" gives the same model. Not the serving image (Dockerfile). What fixes the result:
#   - the base image is pinned by digest (refresh together with the serving Dockerfile, then regenerate the lock);
#   - every Python dependency is pinned with hashes (requirements-train.lock) and installed with --require-hashes;
#   - one thread (OMP/OpenBLAS/MKL), fixed hash seed, UTC, no bytecode: nothing depends on the host's CPU count or clock.
# Usage and the reproducibility experiment: README.md, "Training image".
FROM mirror.gcr.io/library/python:3.15-slim@sha256:63bb298d2b7b88f176f51b5189f54ce6535c997682ea70885d2132f5d473a8a5 AS build
WORKDIR /src
COPY requirements-train.lock ./
RUN pip install --no-cache-dir --require-hashes --no-deps --prefix=/install -r requirements-train.lock

FROM mirror.gcr.io/library/python:3.15-slim@sha256:63bb298d2b7b88f176f51b5189f54ce6535c997682ea70885d2132f5d473a8a5
RUN useradd --uid 10001 --create-home trainer
# lightgbm's wheel links libgomp dynamically; python:*-slim does not ship it. Same pinned packages as the serving image
# (hadolint DL3008); zlib1g carries the fixes for the HIGH findings the base image does not have yet.
RUN apt-get update && apt-get install -y --no-install-recommends libgomp1=14.2.0-19 zlib1g=1:1.3.dfsg+really1.3.1-1+deb13u1 \
    && rm -rf /var/lib/apt/lists/*
# pip/setuptools are not needed at runtime and their vendored libs carry unpatched CVEs: remove them.
RUN pip uninstall -y pip setuptools wheel
COPY --from=build /install /usr/local
COPY src/ /app/src/
ENV PYTHONPATH=/app/src \
    PYTHONHASHSEED=0 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    OMP_NUM_THREADS=1 \
    OPENBLAS_NUM_THREADS=1 \
    MKL_NUM_THREADS=1 \
    TZ=UTC \
    LC_ALL=C.UTF-8
USER 10001
WORKDIR /work
ENTRYPOINT ["python", "-m"]
CMD ["shp_ml.pipeline", "--help"]
