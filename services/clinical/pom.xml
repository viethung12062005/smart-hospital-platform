<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.shp</groupId>
    <artifactId>shp-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>
  <artifactId>clinical</artifactId>
  <name>clinical — Patient records, encounters, history search, account linking (FHIR)</name>

  <dependencies>
    <dependency>
      <groupId>org.shp</groupId>
      <artifactId>shp-service-defaults</artifactId>
    </dependency>
    <dependency>
      <groupId>org.shp</groupId>
      <artifactId>shp-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.shp</groupId>
      <artifactId>shp-data-mongo</artifactId>
    </dependency>
    <dependency>
      <groupId>org.shp</groupId>
      <artifactId>shp-messaging</artifactId>
    </dependency>
    <dependency>
      <groupId>org.shp</groupId>
      <artifactId>shp-fhir</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-testcontainers</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-mongodb</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>app</finalName>
    <resources>
      <resource>
        <directory>src/main/resources</directory>
      </resource>
      <resource>
        <!-- Embed the terminology catalogue: the loader reads the exact version in contracts/ at startup -->
        <directory>${project.basedir}/../../contracts/terminology/dist</directory>
        <targetPath>terminology</targetPath>
        <includes>
          <include>*.json</include>
        </includes>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
