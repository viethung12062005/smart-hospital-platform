<?xml version="1.0" encoding="UTF-8"?>
<!-- Default logging for EVERY service (loaded from shp-service-defaults).
     NFR-O4: structured log with trace-id, NO PII (NFR-SEC13).
     %mask applies PiiMaskingConverter to mask email/phone/CCCD/BHYT/date in the message. -->
<configuration>
  <include resource="org/springframework/boot/logging/logback/defaults.xml"/>
  <conversionRule conversionWord="mask" class="org.shp.servicedefaults.logging.PiiMaskingConverter"/>

  <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} %-5level [%thread] [%X{traceId:-},%X{spanId:-}] %logger{40} - %mask%n${LOG_EXCEPTION_CONVERSION_WORD:-%wEx}</pattern>
    </encoder>
  </appender>

  <root level="INFO">
    <appender-ref ref="CONSOLE"/>
  </root>
</configuration>
