<?xml version="1.0" encoding="UTF-8"?>
<!-- Root Maven build of the Smart Hospital Platform (ADR-0015). One reactor for the shared library (libs/java) and 8 services (services/).
     Library versions are centralized here; child modules do NOT declare versions. Build one service: mvn -pl services/scheduling -am verify -->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.2</version>
    <relativePath/>
  </parent>

  <groupId>org.shp</groupId>
  <artifactId>shp-parent</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>Smart Hospital Platform</name>

  <modules>
    <module>libs/java/shp-service-defaults</module>
    <module>libs/java/shp-authz</module>
    <module>libs/java/shp-events</module>
    <module>libs/java/shp-security</module>
    <module>libs/java/shp-web</module>
    <module>libs/java/shp-data-postgres</module>
    <module>libs/java/shp-data-mongo</module>
    <module>libs/java/shp-messaging</module>
    <module>libs/java/shp-fhir</module>
    <module>services/gateway</module>
    <module>services/scheduling</module>
    <module>services/notification</module>
    <module>services/clinical</module>
    <module>services/document</module>
    <module>services/audit</module>
  </modules>

  <properties>
    <java.version>21</java.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- Versions checked on Maven Central on 2026-10-28 (docs/04-devops/progress-log.md, Part J) -->
    <hapi-fhir.version>8.12.1</hapi-fhir.version>
    <json-schema-validator.version>3.0.8</json-schema-validator.version>
    <cloudevents.version>5.1.0</cloudevents.version>
    <!-- Messaging (13-events §1.1), checked on Maven Central on 2026-11-03: same Spring Cloud as the gateway (works with Boot 4.1);
         Spring Cloud Azure 7.4.0 released 07/2026 -->
    <spring-cloud.version>2025.1.4</spring-cloud.version>
    <spring-cloud-azure.version>7.4.0</spring-cloud-azure.version>
    <!-- The Spring Cloud BOM pulls amqp-client 5.30.0 (4 HIGH CVEs with available patches: 63337/69219/69220/75516); the image scan blocks
         HIGH CVEs that have patches, so pin the latest patched version -->
    <amqp-client.version>5.37.1</amqp-client.version>
    <!-- azure-core-amqp pulls proton-j 0.34.1 (CVE-2026-66274, patch 0.35.0); same reason, the image scan blocks it -->
    <proton-j.version>0.35.0</proton-j.version>
    <archunit.version>1.5.1</archunit.version>
    <spotless.version>3.10.4</spotless.version>
    <jacoco.version>0.8.16</jacoco.version>
    <!-- Checked on Maven Central on 2026-11-03 (06/10 build): JDBC plugin that obtains Entra tokens for PostgreSQL on Azure (02-db-scheduling §5) -->
    <azure-identity-extensions.version>1.2.10</azure-identity-extensions.version>
    <!-- Minimum line coverage threshold for each module that has code (CI blocks below it) -->
    <shp.coverage.minimum>0.70</shp.coverage.minimum>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>com.azure</groupId>
        <artifactId>azure-identity-extensions</artifactId>
        <version>${azure-identity-extensions.version}</version>
      </dependency>
      <dependency>
        <groupId>org.shp</groupId>
        <artifactId>shp-service-defaults</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.shp</groupId>
        <artifactId>shp-authz</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.shp</groupId>
        <artifactId>shp-events</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.shp</groupId>
        <artifactId>shp-security</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.shp</groupId>
        <artifactId>shp-web</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.shp</groupId>
        <artifactId>shp-data-postgres</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.shp</groupId>
        <artifactId>shp-data-mongo</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.shp</groupId>
        <artifactId>shp-fhir</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>ca.uhn.hapi.fhir</groupId>
        <artifactId>hapi-fhir-structures-r4</artifactId>
        <version>${hapi-fhir.version}</version>
      </dependency>
      <dependency>
        <groupId>com.networknt</groupId>
        <artifactId>json-schema-validator</artifactId>
        <version>${json-schema-validator.version}</version>
      </dependency>
      <dependency>
        <groupId>io.cloudevents</groupId>
        <artifactId>cloudevents-core</artifactId>
        <version>${cloudevents.version}</version>
      </dependency>
      <dependency>
        <groupId>com.tngtech.archunit</groupId>
        <artifactId>archunit-junit5</artifactId>
        <version>${archunit.version}</version>
      </dependency>
      <dependency>
        <groupId>org.shp</groupId>
        <artifactId>shp-messaging</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.springframework.cloud</groupId>
        <artifactId>spring-cloud-dependencies</artifactId>
        <version>${spring-cloud.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>com.azure.spring</groupId>
        <artifactId>spring-cloud-azure-dependencies</artifactId>
        <version>${spring-cloud-azure.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <!-- Must be declared after the BOM to override the version managed by the BOM (see amqp-client.version) -->
      <dependency>
        <groupId>com.rabbitmq</groupId>
        <artifactId>amqp-client</artifactId>
        <version>${amqp-client.version}</version>
      </dependency>
      <dependency>
        <groupId>org.apache.qpid</groupId>
        <artifactId>proton-j</artifactId>
        <version>${proton-j.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>com.diffplug.spotless</groupId>
          <artifactId>spotless-maven-plugin</artifactId>
          <version>${spotless.version}</version>
        </plugin>
        <plugin>
          <groupId>org.jacoco</groupId>
          <artifactId>jacoco-maven-plugin</artifactId>
          <version>${jacoco.version}</version>
        </plugin>
      </plugins>
    </pluginManagement>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <release>${java.version}</release>
          <parameters>true</parameters>
          <compilerArgs>
            <!-- Warnings = errors -->
            <arg>-Xlint:all,-processing,-serial,-options</arg>
            <arg>-Werror</arg>
          </compilerArgs>
        </configuration>
      </plugin>
      <plugin>
        <!-- Consistent formatting; CI runs spotless:check (mvn verify calls check in the verify phase) -->
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <configuration>
          <java>
            <googleJavaFormat/>
            <removeUnusedImports/>
          </java>
        </configuration>
        <executions>
          <execution>
            <goals><goal>check</goal></goals>
            <phase>verify</phase>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>prepare</id>
            <goals><goal>prepare-agent</goal></goals>
          </execution>
          <execution>
            <id>report</id>
            <phase>verify</phase>
            <goals><goal>report</goal></goals>
          </execution>
          <execution>
            <id>check</id>
            <phase>verify</phase>
            <goals><goal>check</goal></goals>
            <configuration>
              <haltOnFailure>true</haltOnFailure>
              <rules>
                <rule>
                  <element>BUNDLE</element>
                  <limits>
                    <limit>
                      <counter>LINE</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>${shp.coverage.minimum}</minimum>
                    </limit>
                  </limits>
                </rule>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
