{
  "displayName": "Smart Hospital (local)",
  "sslRequired": "none",
  "clients": [
    {
      "clientId": "shp-web",
      "redirectUris": [
        "http://localhost:5173/*",
        "http://localhost:4173/*"
      ],
      "webOrigins": [
        "+"
      ]
    },
    {
      "clientId": "shp-test",
      "name": "Local test only: obtain tokens with username/password",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "defaultClientScopes": [
        "basic",
        "profile",
        "email"
      ],
      "protocolMappers": [
        {
          "name": "roles-claim",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "audience-shp-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "shp-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ]
}
