{
  "realm": "shp",
  "enabled": true,
  "displayName": "Smart Hospital",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "accessTokenLifespan": 900,
  "roles": {
    "realm": [
      {
        "name": "patient",
        "description": "Patient"
      },
      {
        "name": "doctor",
        "description": "Doctor",
        "composites": {
          "realm": [
            "mfa-required"
          ]
        }
      },
      {
        "name": "nurse",
        "description": "Nurse",
        "composites": {
          "realm": [
            "mfa-required"
          ]
        }
      },
      {
        "name": "admin",
        "description": "Administrator",
        "composites": {
          "realm": [
            "mfa-required"
          ]
        }
      },
      {
        "name": "dpo",
        "description": "Data protection officer",
        "composites": {
          "realm": [
            "mfa-required"
          ]
        }
      },
      {
        "name": "mfa-required",
        "description": "Marker included in every staff role: the browser flow demands a TOTP code from its holders (IAM-10)"
      }
    ]
  },
  "clients": [
    {
      "clientId": "shp-web",
      "name": "Smart Hospital web (PWA)",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "defaultClientScopes": [
        "basic",
        "web-origins",
        "profile",
        "email"
      ],
      "protocolMappers": [
        {
          "name": "roles-claim",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "audience-shp-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "shp-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        },
        {
          "name": "amr-claim",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-amr-mapper",
          "config": {
            "id.token.claim": "true",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "shp-api",
      "name": "Smart Hospital API (audience)",
      "enabled": true,
      "bearerOnly": true,
      "protocolMappers": []
    }
  ],
  "otpPolicyType": "totp",
  "otpPolicyAlgorithm": "HmacSHA1",
  "otpPolicyDigits": 6,
  "otpPolicyPeriod": 30,
  "otpPolicyInitialCounter": 0,
  "sslRequired": "external",
  "passwordPolicy": "length(12) and maxLength(128) and notUsername and notEmail and hashAlgorithm(argon2) and passwordBlacklist(breached-passwords.txt)",
  "bruteForceProtected": true,
  "permanentLockout": false,
  "failureFactor": 5,
  "waitIncrementSeconds": 60,
  "maxFailureWaitSeconds": 900,
  "minimumQuickLoginWaitSeconds": 60,
  "quickLoginCheckMilliSeconds": 1000,
  "maxDeltaTimeSeconds": 43200,
  "eventsEnabled": true,
  "eventsListeners": [
    "jboss-logging"
  ],
  "eventsExpiration": 7776000,
  "enabledEventTypes": [
    "LOGIN",
    "LOGIN_ERROR",
    "LOGOUT",
    "REGISTER",
    "REGISTER_ERROR",
    "UPDATE_PASSWORD",
    "UPDATE_PASSWORD_ERROR",
    "UPDATE_TOTP",
    "REMOVE_TOTP",
    "RESET_PASSWORD",
    "RESET_PASSWORD_ERROR",
    "CLIENT_LOGIN",
    "CLIENT_LOGIN_ERROR",
    "USER_DISABLED_BY_TEMPORARY_LOCKOUT",
    "USER_DISABLED_BY_PERMANENT_LOCKOUT"
  ],
  "adminEventsEnabled": true,
  "adminEventsDetailsEnabled": false
}
