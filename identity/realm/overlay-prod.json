{
  "clients": [
    {
      "clientId": "shp-web",
      "redirectUris": [
        "https://${SHP_PUBLIC_HOST}/*"
      ],
      "webOrigins": [
        "https://${SHP_PUBLIC_HOST}"
      ]
    }
  ],
  "serviceClientAuth": {
    "type": "federated-jwt",
    "identityProvider": "kubernetes"
  },
  "identityProviders": [
    {
      "alias": "kubernetes",
      "providerId": "kubernetes",
      "enabled": true,
      "hideOnLogin": true,
      "config": {
        "issuer": "${SHP_K8S_OIDC_ISSUER}"
      }
    }
  ]
}
