{
  "clients": [
    {
      "clientId": "shp-web",
      "redirectUris": [
        "https://${SHP_PUBLIC_HOST}/*"
      ],
      "webOrigins": [
        "https://${SHP_PUBLIC_HOST}"
      ]
    }
  ],
  "serviceClientAuth": {
    "type": "federated-jwt",
    "identityProvider": "kubernetes"
  },
  "identityProviders": [
    {
      "alias": "kubernetes",
      "providerId": "kubernetes",
      "enabled": true,
      "hideOnLogin": true,
      "config": {
        "issuer": "${SHP_K8S_OIDC_ISSUER}"
      }
    }
  ],
  "smtpServer": {
    "host": "${SHP_SMTP_HOST}",
    "port": "${SHP_SMTP_PORT}",
    "from": "${SHP_SMTP_FROM}",
    "fromDisplayName": "Smart Hospital",
    "auth": "true",
    "user": "${SHP_SMTP_USER}",
    "password": "${SHP_SMTP_PASSWORD}",
    "starttls": "true",
    "ssl": "false"
  }
}
