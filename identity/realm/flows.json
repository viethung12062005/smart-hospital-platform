  "authenticatorConfig": [
    {
      "alias": "browser-conditional-credential",
      "config": {
        "credentials": "webauthn-passwordless"
      }
    },
    {
      "alias": "create unique user config",
      "config": {
        "require.password.update.after.registration": "false"
      }
    },
    {
      "alias": "first-broker-login-conditional-credential",
      "config": {
        "credentials": "webauthn-passwordless"
      }
    },
    {
      "alias": "review profile config",
      "config": {
        "update.profile.on.first.login": "missing"
      }
    },
    {
      "alias": "shp-user-is-staff",
      "config": {
        "condUserRole": "mfa-required",
        "negate": "false"
      }
    },
    {
      "alias": "shp-user-is-not-staff",
      "config": {
        "condUserRole": "mfa-required",
        "negate": "true"
      }
    },
    {
      "alias": "shp-otp-reference-mfa-staff-browser",
      "config": {
        "default.reference.value": "mfa",
        "default.reference.maxAge": "36000"
      }
    },
    {
      "alias": "shp-otp-reference-mfa-staff-direct-grant",
      "config": {
        "default.reference.value": "mfa",
        "default.reference.maxAge": "36000"
      }
    },
    {
      "alias": "shp-otp-reference-mfa-patient-browser",
