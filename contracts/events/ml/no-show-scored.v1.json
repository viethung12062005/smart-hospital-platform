{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shp.example.org/schemas/ml/no-show-scored/v1.json",
  "title": "shp.ml.no-show-scored.v1",
  "description": "E10: no-show risk score. IDs/codes/timestamps/status only, no PII. Only optional fields may be added within the same version.",
  "type": "object",
  "required": [
    "appointmentId",
    "patientId",
    "start",
    "score",
    "threshold",
    "highRisk",
    "modelName",
    "modelVersion",
    "scoredAt"
  ],
  "properties": {
    "appointmentId": {
      "type": "string",
      "format": "uuid"
    },
    "patientId": {
      "type": "string",
      "format": "uuid"
    },
    "start": {
      "type": "string",
      "format": "date-time"
    },
    "score": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "threshold": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "highRisk": {
      "type": "boolean"
    },
    "modelName": {
      "type": "string",
      "minLength": 1
    },
    "modelVersion": {
      "type": "string",
      "minLength": 1
    },
    "scoredAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
