{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shp.example.org/schemas/scheduling/appointment-booked/v1.json",
  "title": "shp.scheduling.appointment-booked.v1",
  "description": "E1: đặt lịch thành công. Chỉ ID/mã/thời điểm/trạng thái, không PII. Chỉ được thêm trường tùy chọn trong cùng version.",
  "type": "object",
  "required": [
    "appointmentId",
    "version",
    "patientId",
    "practitionerId",
    "slotId",
    "specialty",
    "start",
    "end",
    "channel",
    "bookedAt"
  ],
  "properties": {
    "appointmentId": {
      "type": "string",
      "format": "uuid"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "patientId": {
      "type": "string",
      "format": "uuid"
    },
    "practitionerId": {
      "type": "string",
      "format": "uuid"
    },
    "slotId": {
      "type": "string",
      "format": "uuid"
    },
    "specialty": {
      "type": "string",
      "minLength": 1
    },
    "start": {
      "type": "string",
      "format": "date-time"
    },
    "end": {
      "type": "string",
      "format": "date-time"
    },
    "channel": {
      "type": "string",
      "enum": [
        "web",
        "chatbot",
        "staff"
      ]
    },
    "bookedAt": {
      "type": "string",
      "format": "date-time"
    },
    "ageBand": {
      "type": "string"
    }
  }
}
