root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,json,md}]
indent_size = 2

# Java: Spotless (google-java-format, thụt 2) là nguồn sự thật; chạy mvn spotless:apply.
[{*.java,pom.xml}]
indent_size = 2
